REKENBER_API_ROOT=https://api.rekenber.cz
REKENBER_API_TOKEN=
# PostgreSQL URI, e.g. postgresql://user:password@localhost:5432/isir_annotation_db
REKENBER_ANNOTATION_DB_URL=
REKENBER_ANNOTATIONS_PATH=data/discharge_annotations.jsonl
# REKENBER_TIMEOUT_SECONDS=60
# REKENBER_MAX_WORKERS=8

# Enable publication after a successful local export (or use the publish subcommand).
REKENBER_PUBLISH_REPORT=false
REKENBER_APP_DB_URL=
REKENBER_REPORT_ORGANIZATION_ID=2
# Match the app backend's AWS_REPORTS_S3_BUCKET_NAME / AWS_S3_BUCKET_ROOT_FOLDER.
REKENBER_REPORT_S3_BUCKET=rekenber-generated-reports
REKENBER_REPORT_S3_ROOT=production
REKENBER_REPORT_S3_REGION=us-east-1
# Empty for AWS; match backend AWS_S3_ENDPOINT for Hetzner/Seaweed S3.
REKENBER_REPORT_S3_ENDPOINT=
REKENBER_REPORT_S3_ACCESS_KEY_ID=
REKENBER_REPORT_S3_SECRET_ACCESS_KEY=
